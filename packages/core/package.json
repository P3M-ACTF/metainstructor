{
  "name": "@metapeek/core",
  "version": "0.1.0",
  "description": "Core metadata extractors for MetaPeek",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "exifr": "^7.1.3",
    "file-type": "^19.6.0",
    "js-md5": "^0.8.3",
    "jszip": "^3.10.1",
    "music-metadata": "^10.6.4",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
